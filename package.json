{
  "name": "dsh-wechat-friendly",
  "version": "0.1.0",
  "type": "module",
  "description": "WeChat-friendly channel for DeepSeek Harness: Chinese commands, image cards for workspaces and conversations, per-instance bots. Fork of dsh-wechat-plugin.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "weixin",
    "clawbot",
    "ilink",
    "chatbot",
    "channel",
    "plugin",
    "remote-control"
  ],
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "bin": {
    "dsh-wechat-friendly-send": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./cli": "./cli.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cli.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
